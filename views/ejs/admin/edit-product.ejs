<%- include('../includes/head') %>
<%- include('../includes/navigation') %>

    <section class="page-intro">
        <p class="eyebrow">Admin</p>
        <h1>Add a Product</h1>
        <p>Create a new product entry for the shop catalog.</p>
    </section>

    <section class="panel panel-form">
        <form class="product-form" action="/admin/<% if (editing) { %>edit<% } else { %>add<% } %>-product" method="POST">
            <% if (editing) { %>
                <input type="hidden" name="productId" value="<%= product.id %>">
            <% } %>
            <div class="form-control">
                <label for="title">Product title</label>
                <input id="title" type="text" name="title" placeholder="e.g. Node.js Course" value="<% if (editing) { %><%= product.title %><% } %>" required>
            </div>

            <div class="form-control">
                <label for="imageUrl">Image URL</label>
                <input id="imageUrl" type="url" name="imageUrl" placeholder="https://example.com/image.jpg" value="<% if (editing) { %><%= product.imageUrl %><% } %>" required>
            </div>

            <div class="form-control">
                <label for="price">Price</label>
                <input id="price" type="number" name="price" placeholder="$0.00" step="0.01" min="0" value="<% if (editing) { %><%= product.price %><% } %>" required>
             </div>

             <div class="form-control">
                 <label for="description">Description</label>
                 <input id="description" type="text" name="description" placeholder="e.g. A comprehensive guide to Node.js development" value="<% if (editing) { %><%= product.description %><% } %>" required>
             </div>

            <div class="form-actions">
                <a class="button-link button-ghost" href="/">Cancel</a>
                <button type="submit"><% if (editing) { %>Update Product<% } else { %>Add Product<% } %></button>
            </div>
        </form>
    </section>

<%- include('../includes/end') %>
